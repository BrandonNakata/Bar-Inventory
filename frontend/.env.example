# Copy to .env.local (git-ignored).
# VITE_ variables ship in the browser bundle, so never put secrets here.

# Development only; the demo build sets this in vite.config.js.
# false: real FastAPI backend, true: in-browser fake
VITE_DEMO=false

# Blank in development (Vite proxies /api). Set it when serving from another origin,
# e.g. VITE_API_BASE=http://<pi-address>:8000
VITE_API_BASE=
